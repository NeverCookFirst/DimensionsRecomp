<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gpu-shader-extract</AssemblyName>
    <RootNamespace>GpuShaderExtract</RootNamespace>
  </PropertyGroup>

  <!-- Reuse the archive reader that the mod manager and installer already
       exercise. These are links, so the extraction tool cannot silently drift
       to a second interpretation of TT's DAT/HDR format. -->
  <ItemGroup>
    <Compile Include="..\..\DimensionsModManager\DatArchive.cs"
             Link="Archive\DatArchive.cs" />
    <Compile Include="..\..\DimensionsModManager\Dflt.cs"
             Link="Archive\Dflt.cs" />
  </ItemGroup>
</Project>
